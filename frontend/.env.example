# ----------------------------------------------------------------------
# Cliente React del ICAP · variables de entorno
# Copie este archivo como .env (desarrollo) o .env.production (publicación).
# ----------------------------------------------------------------------

# URL de la API RESTful (Laravel).
#   Desarrollo:  /api   (Vite la reenvía a http://127.0.0.1:8000)
#   Producción:  /inf513/grupoXXsa/proyecto2/backend/public/api
VITE_API_URL=/api

# Subcarpeta donde se publica el sitio (con barra al inicio y al final).
#   Desarrollo:  /
#   Producción:  /inf513/grupoXXsa/proyecto2/
VITE_BASE=/

# Tipo de enrutador: "browser" (URLs limpias, requiere .htaccess) o "hash" (/#/ruta,
# funciona en cualquier servidor). Debe coincidir con FRONTEND_ROUTER del backend.
VITE_ROUTER=browser

# Solo desarrollo: a dónde reenvía Vite las llamadas /api
VITE_PROXY_API=http://127.0.0.1:8000
