# Copie este archivo como .env.production antes de ejecutar "npm run build"
# y reemplace grupoXXsa por el usuario del grupo en tecnoweb.

VITE_API_URL=/inf513/grupoXXsa/proyecto2/backend/public/api
VITE_BASE=/inf513/grupoXXsa/proyecto2/

# "hash" no depende de la configuración de Apache (recomendado en tecnoweb).
# Si usa "browser", el .htaccess de dist/ debe estar activo en el servidor.
VITE_ROUTER=hash
