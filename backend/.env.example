APP_NAME="ICAP UAGRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ----------------------------------------------------------------------
# CAPA 3 · Base de datos PostgreSQL
# Local (docker compose up -d): 127.0.0.1:5433 / db_icap / icap / icap_local
# Producción: db.tecnoweb.org.bo (desde el propio servidor suele ser localhost)
# ----------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=db_icap
DB_USERNAME=icap
DB_PASSWORD=icap_local
DB_SEARCH_PATH=public
DB_TIMEZONE=America/La_Paz

# La API es sin estado (tokens Sanctum): nada de esto usa la base de datos.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ----------------------------------------------------------------------
# CAPA 1 · Cliente React
# FRONTEND_URL se usa en el QR de verificación de certificados y en la pasarela simulada.
# FRONTEND_ROUTER debe coincidir con VITE_ROUTER del frontend (browser | hash).
# CORS_ORIGENES: orígenes permitidos separados por coma (* = cualquiera).
# ----------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
FRONTEND_ROUTER=browser
CORS_ORIGENES=*

# ----------------------------------------------------------------------
# Reglas de negocio
# ----------------------------------------------------------------------
ICAP_NOTA_MINIMA=51
ICAP_ASISTENCIA_MINIMA=80
ICAP_DIAS_PAGO_INICIAL=7
ICAP_ARCHIVO_MAX_KB=4096

# ----------------------------------------------------------------------
# Pasarela PagoFácil (QR). Si se dejan vacías, la pasarela trabaja en modo SIMULADO.
# Las credenciales también pueden cargarse desde el sistema: Finanzas > Métodos de pago.
# Genere el secreto del webhook con: php -r "echo bin2hex(random_bytes(24));"
# ----------------------------------------------------------------------
PAGO_FACIL_TCTOKEN_SERVICE=
PAGO_FACIL_TCTOKEN_SECRET=
PAGO_FACIL_CALLBACK_URL="${APP_URL}/api/pagos/pasarela/callback"
PAGO_FACIL_WEBHOOK_SECRET=
