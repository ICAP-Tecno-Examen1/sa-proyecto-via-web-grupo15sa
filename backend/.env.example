APP_NAME="ICAP UAGRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ----------------------------------------------------------------------
# CAPA 3 · Base de datos PostgreSQL
# Local (docker compose up -d): 127.0.0.1:5433 / db_icap / icap / icap_local
# Producción: db.tecnoweb.org.bo (desde el propio servidor suele ser localhost)
# ----------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=db_icap
DB_USERNAME=icap
DB_PASSWORD=icap_local
DB_SEARCH_PATH=public
DB_TIMEZONE=America/La_Paz

# La API es sin estado (tokens Sanctum): nada de esto usa la base de datos.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ----------------------------------------------------------------------
# CAPA 1 · Cliente React
# FRONTEND_URL se usa en el QR de verificación de certificados.
# FRONTEND_ROUTER debe coincidir con VITE_ROUTER del frontend (browser | hash).
# CORS_ORIGENES: orígenes permitidos separados por coma (* = cualquiera).
# ----------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
FRONTEND_ROUTER=browser
CORS_ORIGENES=*

# ----------------------------------------------------------------------
# Reglas de negocio
# ----------------------------------------------------------------------
ICAP_NOTA_MINIMA=51
ICAP_ASISTENCIA_MINIMA=70
# Carreras: duración de cada módulo en meses (sus 1 o 2 materias se dictan a la vez)
ICAP_MESES_POR_MODULO=1
ICAP_DIAS_PAGO_INICIAL=7
ICAP_ARCHIVO_MAX_KB=4096

# ----------------------------------------------------------------------
# Stripe (pago en línea con tarjeta, Stripe Checkout)
# Lo recomendado es cargar las claves desde el sistema: Finanzas > Métodos de pago.
# Estas variables son el respaldo si el método no tiene claves propias.
#   STRIPE_SECRET_KEY      Panel de Stripe > Developers > API keys > Secret key (sk_test_… en pruebas)
#   STRIPE_WEBHOOK_SECRET  Panel > Developers > Webhooks > su endpoint > Signing secret (whsec_…)
#                          Endpoint: ${APP_URL}/api/pagos/stripe/webhook  · evento checkout.session.completed
#   STRIPE_CURRENCY        moneda en minúsculas (bob = bolivianos)
# ----------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=        # pk_test_… / pk_live_…: el formulario de tarjeta aparece dentro del sistema
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bob
