# ----------------------------------------------------------------------
# Variables para Docker (raíz de Examen2). Copiar como ".env" en esta carpeta.
#
# Sin este archivo, Docker usa la base LOCAL del compose (db_icap) y
# migra + carga datos de prueba automáticamente.
#
# Para la base COMPARTIDA del grupo: completar los campos ICAP_DB_* y dejar
# ICAP_MIGRAR y ICAP_SEMBRAR en false. Así Docker no modifica la base del grupo
# al arrancar. Las migraciones se ejecutan a mano:
#   docker compose exec backend php artisan migrate
# ----------------------------------------------------------------------
ICAP_DB_HOST=www.tecnoweb.org.bo
ICAP_DB_PORT=5432
ICAP_DB_DATABASE=
ICAP_DB_USERNAME=
ICAP_DB_PASSWORD=

ICAP_MIGRAR=false
ICAP_SEMBRAR=false
